    },
    {
      "created": "2026-09-17T20:40:35.55282834Z",
      "created_by": "RUN /bin/sh -c apt-get update     && apt-get install -y --no-install-recommends         ca-certificates         python3         python3-pip         python3-venv     && rm -rf /var/lib/apt/lists/* # buildkit",
      "comment": "buildkit.dockerfile.v0"
    },
    {
